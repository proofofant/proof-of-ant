# /etc/proof-of-ant.env on the server: read by the build, the site and the crank.
# NEXT_PUBLIC_* are baked into the browser bundle at build time: rebuild after changing them.

NEXT_PUBLIC_CLUSTER=devnet
# The browser talks to this site's own RPC proxy; the path tells the wallet which network.
NEXT_PUBLIC_RPC_URL=/api/rpc/devnet
NEXT_PUBLIC_PROGRAM_ID=6XpBQEvCBfx4WM1iGDpUyFGkGXVTXXxcp7pvV6uZEhUU
NEXT_PUBLIC_MINT=
NEXT_PUBLIC_TOKEN_DECIMALS=6
NEXT_PUBLIC_TICKER=ANT

# Server only: the keyed upstream RPC (never shipped to the browser).
RPC_URL=

# Crank: its own funded key, not the program's upgrade authority.
CLUSTER=devnet
MINT=
KEYPAIR=/opt/proof-of-ant/.keys/crank.json

PORT=3000
NODE_ENV=production
